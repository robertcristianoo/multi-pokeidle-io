{
  "name": "multi-pokeidle-io",
  "version": "1.0.0",
  "description": "Várias contas do PokeIdle em uma só janela, com sessões isoladas",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:backup": "node tools/backup-dist.js",
    "dist:backups": "node tools/backup-dist.js --listar",
    "dist:release": "electron-builder --win --publish never --config electron-builder.release.json",
    "test": "node test/run.js",
    "predist": "npm test && node tools/dev-release-info.js",
    "predist:release": "npm test",
    "postdist": "node tools/dev-release-info.js --remove"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.pokeidle.multi",
    "files": ["**/*", "!dist-release/**", "!test/**", "!tools/_x/**", "!.claude/**", "!dist/**", "!dist-backup/**", "!dist-fix/**", "!err.txt"],
    "asarUnpack": ["extensions/**"],
    "win": {
      "target": ["portable", "nsis"],
      "icon": "assets/icon.ico"
    }
  }
}
